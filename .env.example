# Database & Cache Configuration
DATABASE_URL=postgresql://twin_user:twin_password@localhost:5434/twin_db
REDIS_URL=redis://localhost:6379

# Service Ports
PORT=5000
FASTAPI_PORT=8000
VITE_PORT=5173

# AI & Embedding Configuration (LangChain Provider: 'openai', 'gemini', or 'auto')
EMBEDDING_PROVIDER=auto
#OPENAI_API_KEY=your_openai_api_key_here
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
GEMINI_EMBEDDING_MODEL=models/text-embedding-004

# LLM provider - also used by Viva STT/TTS below (was previously
# undocumented here even though llm_service.py already required it)
GEMINI_API_KEY=your_gemini_api_key_here

# Viva Voice Simulator - STT + TTS
# Reuses GEMINI_API_KEY / GOOGLE_API_KEY (set above with your LLM key).
# Without a key, the viva WebSocket degrades gracefully:
# STT returns STT_NOT_CONFIGURED, TTS omits audio_base64, and the
# frontend falls back to the browser's built-in speech APIs.
GEMINI_STT_MODEL=gemini-2.5-flash
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
GEMINI_TTS_VOICE=Kore
